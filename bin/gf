#!/usr/bin/env python3
"""Development launcher for gf (git-folders).

If `.venv/bin/python` exists, replace this process with it. A virtual
environment built for another host is a dirty tree: remove it and run
`uv sync` on this host. When `.venv` is absent, continue under the current
interpreter with `src/` on `sys.path` so `gf` can run without `uv sync`
when its runtime dependency is already available.

The installed console script (`gf` from pyproject.toml) is the preferred
entry point for packaged releases.
"""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VENV_PYTHON = os.path.join(ROOT, ".venv", "bin", "python")

# Prefer the project venv so dependencies are available.
if os.path.exists(VENV_PYTHON) and sys.executable != VENV_PYTHON:
    os.execv(VENV_PYTHON, [VENV_PYTHON, __file__] + sys.argv[1:])

SRC = os.path.join(ROOT, "src")
if SRC not in sys.path:
    sys.path.insert(0, SRC)

from gf import main

sys.exit(main(sys.argv[1:]) or 0)
