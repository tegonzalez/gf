#!/usr/bin/env python3
"""Development launcher for gf (git-folders).

Finds and uses the project virtual-environment interpreter if it exists,
otherwise falls back to the current Python. Adds `src/` to `PYTHONPATH` so the
package can be run without installation.

The installed console script (`gf` from pyproject.toml) is the preferred
entry point for packaged releases.
"""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VENV_PYTHON = os.path.join(ROOT, ".venv", "bin", "python")

# Prefer the project venv so dependencies are available.
if os.path.exists(VENV_PYTHON) and sys.executable != VENV_PYTHON:
    os.execv(VENV_PYTHON, [VENV_PYTHON, __file__] + sys.argv[1:])

SRC = os.path.join(ROOT, "src")
if SRC not in sys.path:
    sys.path.insert(0, SRC)

from gf import main

sys.exit(main(sys.argv[1:]) or 0)
